---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import { getSiteSettings } from '../utils/content';

interface Props {
  title: string;
  siteTitle: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  siteTitle,
  description = '',
  noindex = false,
  ogImage = '/og-image.jpg',
} = Astro.props;

// Most `seoTitle` values already end in the brand name. Appending it
// unconditionally produced "... - Rogers Law Office LLC | Rogers Law Office LLC"
// and blew past the ~60 char SERP limit, so only append when it's absent.
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const canonicalURL = Astro.url.href;
const ogImageAbsolute = new URL(ogImage, Astro.site ?? Astro.url.origin).href;

const siteEntries = await getCollection('site');
const siteSettings = getSiteSettings(siteEntries);

// LocalBusiness/LegalService markup. Everything here is sourced from
// settings.json so the schema can never drift from the rendered footer.
const structuredData = siteSettings
  ? {
      '@context': 'https://schema.org',
      '@type': 'LegalService',
      name: siteSettings.brandName,
      url: Astro.site?.href ?? canonicalURL,
      image: ogImageAbsolute,
      telephone: siteSettings.phones ?? [siteSettings.primaryPhone],
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteSettings.address.street,
        addressLocality: siteSettings.address.city,
        addressRegion: siteSettings.address.state,
        postalCode: siteSettings.address.zip,
        addressCountry: 'US',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Champaign County, Illinois',
      },
      knowsAbout: [
        'Family Law',
        'Divorce',
        'Child Custody',
        'Child Support',
        'Spousal Support',
      ],
    }
  : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:site_name" content={siteTitle} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageAbsolute} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbsolute} />

<!-- Favicons -->
<link rel="icon" type="image/x-icon" href="/favicons/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

<meta name="theme-color" content="#6B2B1F" />
<meta name="generator" content={Astro.generator} />
<title>{fullTitle}</title>

{
  structuredData && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  )
}

<ClientRouter />

<!-- Google Fonts: non-blocking load via print media trick -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Libre+Baskerville:wght@400;700&display=swap" />
<link
  href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Libre+Baskerville:wght@400;700&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Libre+Baskerville:wght@400;700&display=swap"
    rel="stylesheet"
  />
</noscript>

