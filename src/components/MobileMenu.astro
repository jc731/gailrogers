---
import { Icon } from 'astro-icon/components';
import DropdownIndicator from './DropdownIndicator.astro';
import Logo from './Logo.astro';

interface Props {
  navigation: Array<{
    label: string;
    href: string;
    children?: Array<{
      label: string;
      href: string;
    }>;
  }>;
  primaryPhone?: string;
  currentPath?: string;
}

const { navigation, primaryPhone, currentPath = '' } = Astro.props;
const menuId = 'mobile-menu';
const buttonId = 'mobile-menu-button';
---

<!-- Hamburger button (open only — close is handled by button inside the panel) -->
<button
  id={buttonId}
  type="button"
  aria-expanded="false"
  aria-controls={menuId}
  aria-label="Open navigation menu"
  class="lg:hidden focus-ring p-2 rounded-sm min-h-[44px] min-w-[44px] flex items-center justify-center text-gray-700 hover:text-brand-primary transition-colors"
  data-mobile-menu-button
>
  <Icon
    name="mdi:menu"
    class="w-6 h-6"
    aria-hidden="true"
  />
</button>

<!-- Full-screen menu panel -->
<!-- Starts closed: `inert` keeps the off-screen links out of the tab order and
     the accessibility tree until the panel is actually opened. -->
<div
  id={menuId}
  class="lg:hidden fixed top-0 left-0 right-0 bottom-0 bg-white z-50 transform translate-x-full transition-transform duration-300 ease-in-out overflow-y-auto"
  data-mobile-menu
  inert
  aria-hidden="true"
>
  <!-- Panel header: logo + close button (mirrors the topbar layout) -->
  <div class="flex justify-between items-center px-4 py-4 shadow-xs">
    <Logo brandName="Rogers" tagline="Law Office LLC" href="/" />
    <button
      type="button"
      aria-label="Close navigation menu"
      class="focus-ring p-2 rounded-sm min-h-[44px] min-w-[44px] flex items-center justify-center text-gray-700 hover:text-brand-primary transition-colors"
      data-mobile-menu-close
    >
      <Icon name="mdi:close" class="w-6 h-6" aria-hidden="true" />
    </button>
  </div>

  <nav class="container mx-auto px-4 py-6">
    <ul class="space-y-2">
      {navigation.map((item, index) => {
        const submenuId = `mobile-submenu-${index}`;
        const submenuButtonId = `mobile-submenu-button-${index}`;

        return (
          <li>
            {item.children && item.children.length > 0 ? (
              <>
                {(() => {
                  const isParentActive = currentPath === item.href || item.children?.some(child => currentPath === child.href);
                  const linkClasses = isParentActive
                    ? "flex-1 text-left text-brand-primary font-semibold hover:text-brand-primary focus-ring px-4 py-3 rounded-sm min-h-[44px] flex items-center"
                    : "flex-1 text-left text-gray-700 hover:text-brand-primary focus-ring px-4 py-3 rounded-sm min-h-[44px] flex items-center";
                  const buttonClasses = "flex items-center justify-center min-h-[44px] min-w-[44px] focus-ring px-2 rounded-sm";

                  return (
                    <>
                      <div class="flex items-center">
                        <a
                          href={item.href}
                          class={linkClasses}
                          data-mobile-menu-link
                        >
                          {item.label}
                        </a>
                        <button
                          id={submenuButtonId}
                          type="button"
                          aria-expanded="false"
                          aria-controls={submenuId}
                          aria-label={`Toggle ${item.label} submenu`}
                          class={buttonClasses}
                          data-mobile-submenu-button={index}
                        >
                          <DropdownIndicator size="sm" className="text-current" />
                        </button>
                      </div>
                      <ul
                        id={submenuId}
                        class="hidden pl-4 space-y-1 mt-1"
                        data-mobile-submenu={index}
                      >
                        {item.children.map((child) => {
                          const isChildActive = currentPath === child.href;
                          const childClasses = isChildActive
                            ? "block text-brand-primary font-semibold bg-brand-light focus-ring px-4 py-2 rounded-sm min-h-[44px] flex items-center"
                            : "block text-gray-700 hover:text-brand-primary hover:bg-brand-light focus-ring px-4 py-2 rounded-sm min-h-[44px] flex items-center";

                          return (
                            <li>
                              <a
                                href={child.href}
                                class={childClasses}
                                data-mobile-menu-link
                              >
                                {child.label}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </>
                  );
                })()}
              </>
            ) : (
              <a
                href={item.href}
                class={currentPath === item.href
                  ? "block text-brand-primary font-semibold hover:text-brand-primary hover:bg-brand-light focus-ring px-4 py-3 rounded-sm min-h-[44px] flex items-center"
                  : "block text-gray-700 hover:text-brand-primary hover:bg-brand-light focus-ring px-4 py-3 rounded-sm min-h-[44px] flex items-center"}
                data-mobile-menu-link
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })}
      {primaryPhone && (
        <li class="pt-4 border-t border-gray-200">
          <a
            href={`tel:${primaryPhone}`}
            class="block text-brand-primary font-semibold focus-ring px-4 py-3 rounded-sm min-h-[44px] flex items-center"
            data-mobile-menu-link
          >
            {primaryPhone}
          </a>
        </li>
      )}
    </ul>
  </nav>
</div>

<script is:inline>
  // <ClientRouter /> swaps the <body> on every internal navigation, so the
  // markup this wires up is replaced each time. Binding on DOMContentLoaded
  // would only ever work on the first page load and leave the hamburger dead
  // afterwards - init runs on `astro:page-load` instead, which fires on the
  // initial load and after every client-side swap.
  (function () {
    function currentMenu() {
      return document.querySelector('[data-mobile-menu]');
    }

    function currentButton() {
      return document.querySelector('[data-mobile-menu-button]');
    }

    function isOpen() {
      const menu = currentMenu();
      return !!menu && !menu.classList.contains('translate-x-full');
    }

    function openMenu() {
      const menu = currentMenu();
      const button = currentButton();
      const headerLogo = document.querySelector('[data-header-logo]');
      if (!menu || !button) return;

      menu.classList.remove('translate-x-full');
      menu.removeAttribute('inert');
      menu.removeAttribute('aria-hidden');
      button.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (headerLogo) {
        headerLogo.style.opacity = '0';
        headerLogo.style.pointerEvents = 'none';
      }
    }

    function closeMenu() {
      const menu = currentMenu();
      const button = currentButton();
      const headerLogo = document.querySelector('[data-header-logo]');
      if (!menu || !button) return;

      // Move focus out before `inert` applies, otherwise the browser drops it
      // to <body> and the user loses their place.
      if (menu.contains(document.activeElement)) {
        button.focus();
      }

      menu.classList.add('translate-x-full');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      button.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (headerLogo) {
        headerLogo.style.opacity = '';
        headerLogo.style.pointerEvents = '';
      }

      document.querySelectorAll('[data-mobile-submenu]').forEach(function (submenu) {
        submenu.classList.add('hidden');
        const submenuButton = document.querySelector('[aria-controls="' + submenu.id + '"]');
        if (submenuButton) submenuButton.setAttribute('aria-expanded', 'false');
      });
    }

    function init() {
      const menuButton = currentButton();
      const menu = currentMenu();
      if (!menuButton || !menu) return;

      // Idempotent: `astro:page-load` and the direct call below can both reach
      // this on first load, and only fresh markup should ever be bound.
      if (menuButton.dataset.menuBound === 'true') return;
      menuButton.dataset.menuBound = 'true';

      // Every navigation lands with the panel closed.
      menu.classList.add('translate-x-full');
      menu.setAttribute('inert', '');
      menu.setAttribute('aria-hidden', 'true');
      menuButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';

      // Buttons fire click natively on Enter/Space, so no extra key handling.
      menuButton.addEventListener('click', function () {
        if (isOpen()) { closeMenu(); } else { openMenu(); }
      });

      const closeButton = document.querySelector('[data-mobile-menu-close]');
      if (closeButton) closeButton.addEventListener('click', closeMenu);

      document.querySelectorAll('[data-mobile-submenu-button]').forEach(function (button) {
        button.addEventListener('click', function () {
          const buttonIndex = button.getAttribute('data-mobile-submenu-button');
          const submenu = document.querySelector('[data-mobile-submenu="' + buttonIndex + '"]');
          const isExpanded = button.getAttribute('aria-expanded') === 'true';
          if (submenu) {
            submenu.classList.toggle('hidden', isExpanded);
            button.setAttribute('aria-expanded', isExpanded ? 'false' : 'true');
          }
        });
      });

      document.querySelectorAll('[data-mobile-menu-link]').forEach(function (link) {
        link.addEventListener('click', closeMenu);
      });
    }

    // `document` and `window` survive view transitions, so these bind once.
    if (!window.__rloMobileMenuBound) {
      window.__rloMobileMenuBound = true;

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && isOpen()) {
          closeMenu();
          const button = currentButton();
          if (button) button.focus();
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth >= 1024 && isOpen()) closeMenu();
      });

      document.addEventListener('astro:page-load', init);
    }

    init();
  })();
</script>
