---
import NetlifyContactForm from "./NetlifyContactForm.astro";
import Section from "../Section.astro";
import { PADDING_STANDARD } from "../../utils/spacing";

interface Props {
  title?: string;
  introText?: string;
  className?: string;
}

const {
  title = "Contact us",
  introText = "Please fill out the form below and I will contact you.",
  className = "",
} = Astro.props;
---

<Section
  className={`${PADDING_STANDARD} contact-form-section ${className}`.trim()}
  containerClassName="container mx-auto max-w-6xl"
>
  <div
    class="bg-white border-l-4 border-r-4 border-heading-subheading px-4 sm:px-6 py-8 shadow-xs"
  >
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 break-words">
      {title}
    </h2>
    {introText && <p class="text-gray-700 mb-6 break-words">{introText}</p>}

    <NetlifyContactForm />
  </div>
</Section>

<style>
  .contact-form-section {
    background-color: #ffffff;
  }

  .contact-form-section .border-heading-subheading {
    border-color: #8c733d;
  }

  .hidden {
    display: none;
  }
</style>
