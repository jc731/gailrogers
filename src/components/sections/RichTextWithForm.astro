---
import Section from '../Section.astro';
import FormInput from '../forms/FormInput.astro';
import FormTextarea from '../forms/FormTextarea.astro';
import Button from '../Button.astro';
import { PADDING_COMPACT } from '../../utils/spacing';

interface Props {
  content: string;
  formTitle?: string;
  formIntroText?: string;
  className?: string;
}

const {
  content,
  formTitle = "Contact us",
  formIntroText = "Please fill out the form below and I will contact you.",
  className = '',
} = Astro.props;

const defaultSectionClassName = `${PADDING_COMPACT} ${className}`.trim();
const finalContainerClassName = 'container mx-auto max-w-8xl';
---

<Section className={defaultSectionClassName} containerClassName={finalContainerClassName}>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
    <!-- Rich Text Content -->
    <div class="rich-text-content break-words">
      <div 
        set:html={content}
        class="break-words"
      />
    </div>

    <!-- Contact Form -->
    <div class="bg-white border-l-4 border-r-4 border-heading-subheading px-4 sm:px-6 py-8 shadow-sm">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-4 break-words">
        {formTitle}
      </h2>
      {formIntroText && <p class="text-gray-700 mb-6 break-words">{formIntroText}</p>}

      <form
        id="contact-form"
        name="contact"
        method="POST"
        action="#"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="space-y-6"
        novalidate
      >
        <!-- Honeypot field for spam protection -->
        <p class="hidden">
          <label>
            Don't fill this out if you're human: <input name="bot-field" />
          </label>
        </p>
        <FormInput
          id="contact-name"
          name="name"
          label="Full Name"
          type="text"
          required={true}
        />

        <FormInput
          id="contact-email"
          name="email"
          label="Email Address"
          type="email"
          required={true}
        />

        <FormInput
          id="contact-phone"
          name="phone"
          label="Phone Number"
          type="tel"
          required={true}
        />

        <FormTextarea
          id="contact-message"
          name="message"
          label="Message"
          rows={6}
          required={true}
        />

        <div class="pt-4">
          <Button
            type="submit"
            variant="heading-subheading"
            size="lg"
            rounded="md"
            focusRing="dark"
          >
            Submit
          </Button>
        </div>
      </form>
    </div>
  </div>
</Section>

<style>
  .rich-text-content :global(h2) {
    @apply text-brand-primary text-2xl sm:text-3xl md:text-4xl font-semibold leading-snug mt-2 mb-4 font-sans break-words;
  }

  .rich-text-content :global(h3) {
    @apply text-heading-subheading text-base sm:text-lg md:text-xl font-bold uppercase tracking-wider mt-6 mb-3 font-sans break-words;
  }

  .rich-text-content :global(p) {
    @apply text-black mb-4 break-words;
  }

  .rich-text-content :global(ul) {
    @apply text-black list-disc pl-6 mb-4;
  }

  .rich-text-content :global(ol) {
    @apply text-black list-decimal pl-6 mb-4;
  }

  .rich-text-content :global(li) {
    @apply text-black mb-1.5;
  }

  .rich-text-content :global(strong) {
    @apply text-black font-bold;
  }

  .rich-text-content :global(a) {
    @apply break-words hyphens-auto;
  }

  .border-heading-subheading {
    border-color: #8c733d;
  }

  .hidden {
    display: none;
  }
</style>
