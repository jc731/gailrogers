---
import Section from '../Section.astro';
import { PADDING_COMPACT } from '../../utils/spacing';

interface Props {
  content: string;
  className?: string;
  sectionClassName?: string;
  containerClassName?: string;
}

const { content, className = '', sectionClassName, containerClassName } = Astro.props;

const defaultSectionClassName = `${PADDING_COMPACT} ${className}`.trim();
const finalSectionClassName = sectionClassName || defaultSectionClassName;
const finalContainerClassName = containerClassName || 'container mx-auto max-w-6xl';
---

<Section className={finalSectionClassName} containerClassName={finalContainerClassName}>
  <div
    set:html={content}
    class="rich-text-content break-words"
  />
</Section>

<style>
  /* Astro compiles scoped <style> blocks separately, so Tailwind v4 needs an
     explicit reference to the theme before @apply can resolve brand tokens. */
  @reference "../../styles/global.css";

  .rich-text-content :global(h2) {
    @apply text-brand-primary text-2xl sm:text-3xl md:text-4xl font-semibold leading-snug mt-2 mb-4 font-sans break-words;
  }

  .rich-text-content :global(h3) {
    @apply text-heading-subheading text-base sm:text-lg md:text-xl font-bold uppercase tracking-wider mt-6 mb-3 font-sans break-words;
  }

  .rich-text-content :global(p) {
    @apply text-black mb-4 break-words;
  }

  .rich-text-content :global(ul) {
    @apply text-black list-disc pl-6 mb-4;
  }

  .rich-text-content :global(ol) {
    @apply text-black list-decimal pl-6 mb-4;
  }

  .rich-text-content :global(li) {
    @apply text-black mb-1.5;
  }

  .rich-text-content :global(strong) {
    @apply text-black font-bold;
  }

  .rich-text-content :global(a) {
    @apply break-words hyphens-auto;
  }

  /* Client testimonials. Reuses the left-accent-border treatment already used
     by the contact form panels so quotes read as part of the same system.
     The HTML spec requires quote attribution to sit OUTSIDE <blockquote>, so
     testimonials are marked up as <figure> > <blockquote> + <figcaption>. */
  .rich-text-content :global(figure) {
    @apply border-l-4 border-heading-subheading bg-white px-4 sm:px-6 py-5 my-6 break-words;
  }

  .rich-text-content :global(blockquote p:last-of-type) {
    @apply mb-0;
  }

  .rich-text-content :global(figcaption) {
    @apply mt-4 text-heading-subheading text-sm font-bold uppercase tracking-wider font-sans;
  }
</style>
