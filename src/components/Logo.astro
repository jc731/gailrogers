---
import touchmark from "../content/images/logo-touch.png";

interface Props {
  brandName?: string;
  tagline?: string;
  href?: string;
  className?: string;
}

const {
  brandName = "ROGERS",
  tagline = "LAW OFFICE LLC",
  href = "/",
  className = "",
} = Astro.props;

const firstLetter = brandName.charAt(0);
const restOfName = brandName.slice(1);
---

<a
  href={href}
  class={`flex items-center gap-0 no-underline ${className}`}
  aria-label={`${brandName} ${tagline} - Home`}
>
  <!-- Touchmark -->
  <div
    class="flex items-center justify-center w-16 h-16 flex-shrink-0 rounded-xl overflow-hidden"
    style="background-color:#ad9e5c;"
  >
    <img
      src={touchmark.src}
      alt=""
      class="p-1 object-contain"
      aria-hidden="true"
    />
  </div>

  <!-- Text section -->
  <div class="flex flex-col ml-2 sm:ml-3 justify-center min-w-0 flex-1">
    <span
      class="text-5xl leading-none break-words text-brand-navy"
      style="font-family: 'Cinzel', serif; font-weight: 600;"
    >
      <span style="font-size: 1.15em;">{firstLetter}</span>{restOfName}
    </span>
    <span
      class="text-sm font-normal leading-tight -mt-1 break-words text-brand-navy"
      style="font-family: 'Libre Baskerville', serif; letter-spacing: 0.2em; text-align: center;"
    >
      {tagline}
    </span>
  </div>
</a>
