---
import "../styles/global.css";
import { getCollection } from "astro:content";
import Head from "../components/Head.astro";
import Logo from "../components/Logo.astro";
import DropdownIndicator from "../components/DropdownIndicator.astro";
import MobileMenu from "../components/MobileMenu.astro";
import SiteFooter from "../components/SiteFooter.astro";
// import BreakpointIndicator from '../components/BreakpointIndicator.astro';
import { getSiteSettings } from "../utils/content";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  noindex?: boolean;
}

const { title, description, currentPath = "", noindex = false } = Astro.props;

const siteEntries = await getCollection("site");
const siteSettings = getSiteSettings(siteEntries);

const siteTitle = siteSettings?.brandName || "Site";
const primaryPhone = siteSettings?.primaryPhone || "";
const navigation = siteSettings?.navigation || [];
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      siteTitle={siteTitle}
      description={description}
      noindex={noindex}
    />
  </head>
  <body class="bg-white">
    {/* <BreakpointIndicator /> */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:py-3 focus:bg-brand-primary focus:text-white focus:rounded-sm focus:font-semibold focus:shadow-lg focus-ring-dark min-h-[44px]"
    >
      Skip to content
    </a>

    <header class="bg-white shadow-md">
      <nav class="container mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <div data-header-logo style="transition: opacity 0.2s ease;">
            <Logo brandName="Rogers" tagline="Law Office LLC" href="/" />
          </div>
          <div class="flex gap-6 items-center">
            {/* Desktop Navigation */}
            <div class="hidden lg:flex gap-6 items-center">
              {
                navigation.map((item, index) => {
                  const menuId = `menu-${index}`;
                  const buttonId = `menu-button-${index}`;
                  const isParentActive =
                    currentPath === item.href ||
                    (item.children &&
                      item.children.some(
                        (child) => currentPath === child.href,
                      ));
                  const linkClasses = isParentActive
                    ? "text-lg text-brand-primary font-semibold hover:text-brand-primary focus-ring px-2 py-1 rounded-sm min-h-[44px] flex items-center"
                    : "text-lg text-gray-700 hover:text-brand-primary focus-ring px-2 py-1 rounded-sm min-h-[44px] flex items-center";

                  return (
                    <div class="relative group" data-nav-item={index}>
                      {item.children && item.children.length > 0 ? (
                        <>
                          <div class="flex items-center gap-1">
                            <a
                              href={item.href}
                              id={buttonId}
                              aria-haspopup="true"
                              aria-controls={menuId}
                              class={linkClasses}
                              data-nav-link={index}
                            >
                              {item.label}
                            </a>
                            <span
                              class="pointer-events-none"
                              aria-hidden="true"
                            >
                              <DropdownIndicator
                                size="sm"
                                className="text-current"
                              />
                            </span>
                          </div>
                          <div
                            id={menuId}
                            role="menu"
                            aria-labelledby={buttonId}
                            class="absolute left-0 top-full mt-1 w-64 bg-white shadow-lg rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 z-50"
                            data-nav-menu={index}
                          >
                            <ul class="py-2">
                              {item.children.map((child, childIndex) => {
                                const isChildActive =
                                  currentPath === child.href;
                                const childClasses = isChildActive
                                  ? "block px-4 py-2 text-brand-primary font-semibold bg-brand-light focus-ring rounded-sm mx-2 min-h-[44px] flex items-center"
                                  : "block px-4 py-2 text-gray-700 hover:bg-brand-light hover:text-brand-primary focus-ring rounded-sm mx-2 min-h-[44px] flex items-center";

                                return (
                                  <li role="none">
                                    <a
                                      href={child.href}
                                      role="menuitem"
                                      class={childClasses}
                                      data-nav-child={`${index}-${childIndex}`}
                                    >
                                      {child.label}
                                    </a>
                                  </li>
                                );
                              })}
                            </ul>
                          </div>
                        </>
                      ) : (
                        <a
                          href={item.href}
                          class={
                            currentPath === item.href
                              ? "text-lg text-brand-primary font-semibold hover:text-brand-primary focus-ring px-2 py-1 rounded-sm min-h-[44px] flex items-center"
                              : "text-lg text-gray-700 hover:text-brand-primary focus-ring px-2 py-1 rounded-sm min-h-[44px] flex items-center"
                          }
                        >
                          {item.label}
                        </a>
                      )}
                    </div>
                  );
                })
              }
              {
                primaryPhone && (
                  <a
                    href={`tel:${primaryPhone}`}
                    class="text-lg text-brand-primary font-semibold focus-ring px-2 py-1 rounded-sm min-h-[44px] flex items-center"
                  >
                    {primaryPhone}
                  </a>
                )
              }
            </div>

            {/* Mobile Menu Button */}
            <MobileMenu
              navigation={navigation}
              primaryPhone={primaryPhone}
              currentPath={currentPath}
            />
          </div>

          <script>
            // Keyboard navigation for dropdown menus.
            // Re-runs on every <ClientRouter /> swap - see MobileMenu.astro.
            const initNavKeyboard = () => {
              const navLinks = document.querySelectorAll("[data-nav-link]");

              navLinks.forEach((link) => {
                // Fresh markup only; guards against double-binding.
                if ((link as HTMLElement).dataset.navBound === "true") return;
                (link as HTMLElement).dataset.navBound = "true";

                const linkIndex = link.getAttribute("data-nav-link");
                const menu = document.querySelector(
                  `[data-nav-menu="${linkIndex}"]`,
                );

                if (!menu) return;

                // Query the items live on each keypress rather than caching a
                // NodeList at bind time: this script runs while the document is
                // still parsing, so a cached list can be empty (which silently
                // disabled ArrowDown), and a swap can leave it holding detached
                // nodes.
                const items = () =>
                  Array.from(
                    menu.querySelectorAll("[data-nav-child]"),
                  ) as HTMLElement[];

                const el = menu as HTMLElement;

                const openMenu = () => {
                  link.setAttribute("aria-expanded", "true");
                  // The menu carries `transition-all`, which animates
                  // `visibility` as well - so for the ~200ms transition the
                  // element is still not rendered and focus() silently no-ops.
                  // Suppress the transition for this one commit so the items
                  // are focusable in the same tick, then restore it.
                  el.style.transition = "none";
                  menu.classList.remove("opacity-0", "invisible");
                  el.style.visibility = "visible";
                  el.style.opacity = "1";
                  void el.offsetHeight;
                  el.style.transition = "";
                };

                const closeMenu = () => {
                  link.setAttribute("aria-expanded", "false");
                  menu.classList.add("opacity-0", "invisible");
                  el.style.visibility = "";
                  el.style.opacity = "";
                };

                link.addEventListener("keydown", (e) => {
                  const ev = e as KeyboardEvent;
                  if (ev.key === "ArrowDown") {
                    ev.preventDefault();
                    openMenu();
                    const list = items();
                    if (list.length > 0) list[0].focus();
                  } else if (ev.key === "Escape") {
                    ev.preventDefault();
                    closeMenu();
                  }
                });

                menu.addEventListener("keydown", (e) => {
                  const ev = e as KeyboardEvent;
                  const list = items();
                  const index = list.indexOf(ev.target as HTMLElement);
                  if (index === -1 || list.length === 0) return;

                  if (ev.key === "ArrowDown") {
                    ev.preventDefault();
                    list[(index + 1) % list.length].focus();
                  } else if (ev.key === "ArrowUp") {
                    ev.preventDefault();
                    list[(index - 1 + list.length) % list.length].focus();
                  } else if (ev.key === "Escape") {
                    ev.preventDefault();
                    closeMenu();
                    (link as HTMLElement).focus();
                  }
                });

                const navItem = link.closest("[data-nav-item]");
                navItem?.addEventListener("focusout", () => {
                  setTimeout(() => {
                    if (!navItem?.contains(document.activeElement)) {
                      // Via closeMenu so the inline visibility override set by
                      // openMenu is cleared too.
                      closeMenu();
                    }
                  }, 100);
                });
              });
            };

            document.addEventListener("astro:page-load", initNavKeyboard);
            initNavKeyboard();
          </script>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>
