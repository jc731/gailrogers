---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";

const title = "Page Not Found";
const description = "The page you are looking for could not be found.";
const currentPath = Astro.url.pathname;
---

<BaseLayout
  title={title}
  description={description}
  currentPath={currentPath}
  noindex={true}
>
  <section class="py-20 px-4 md:px-6 lg:px-8">
    <div class="container mx-auto max-w-2xl text-center">
      <h1
        class="text-4xl sm:text-5xl md:text-6xl font-bold text-brand-primary mb-4 break-words"
      >
        404
      </h1>
      <h2
        class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-4 break-words"
      >
        Page Not Found
      </h2>
      <p class="text-lg text-gray-700 mb-8">
        The page you're looking for could not be found. It may have been moved
        or the URL may be incorrect.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <Button href="/" variant="primary">Go to Homepage</Button>
        <Button href="/contact" variant="outline">Contact Us</Button>
      </div>
      <div class="text-left border-t border-gray-200 pt-8">
        <p class="text-gray-600 mb-4 font-semibold">Helpful links:</p>
        <ul class="space-y-2 text-gray-700">
          <li><a href="/" class="hover:text-brand-primary underline">Home</a></li>
          <li><a href="/attorney-profile" class="hover:text-brand-primary underline">Attorney Profile</a></li>
          <li><a href="/practice" class="hover:text-brand-primary underline">Practice Areas</a></li>
          <li><a href="/practice/family-law" class="hover:text-brand-primary underline">Family Law</a></li>
          <li><a href="/practice/divorce" class="hover:text-brand-primary underline">Divorce</a></li>
          <li><a href="/practice/child-custody" class="hover:text-brand-primary underline">Child Custody</a></li>
          <li><a href="/practice/child-support" class="hover:text-brand-primary underline">Child Support</a></li>
          <li><a href="/contact" class="hover:text-brand-primary underline">Contact Us</a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
